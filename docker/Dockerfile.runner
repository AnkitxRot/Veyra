FROM node:22-bookworm-slim

# Install necessary language toolchains
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    gcc \
    g++ \
    default-jdk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install tsx globally for TypeScript execution
RUN npm install -g tsx typescript

# Non-root execution user. The node base image already reserves uid 1000 for
# `node`; rename it so the runner matches the backend's workspace ownership.
RUN usermod -l ide -m -d /home/ide node \
 && usermod -s /bin/bash ide

USER ide
WORKDIR /workspace

CMD ["bash"]
