  "phase3_schedulingSimulation": {
    "currentImmediate": {
      "description": "Current: immediate admission, reject when maxSandboxes reached",
      "analysis": "Under C≤20: all requests admitted, no queuing.\nUnder C>20: 0/40 requests rejected immediately (no wait, clear error).\nNo head-of-line blocking. No starvation. No queue memory.\nRejected requests can retry (client-side).\nThroughput data: C=1: 0.2 req/s, avg=4860ms; C=5: 4.9 req/s, avg=827ms; C=10: 5.7 req/s, avg=1291ms; C=20: 5.1 req/s, avg=2765ms; C=40: 9.6 req/s, avg=1619ms"
    },
    "strictFIFO": {
      "description": "FIFO queue: hold excess requests until a slot opens, serve in order",
      "analysis": "Would eliminate immediate rejections at C>20.\nBut: adds admission wait to ALL queued requests (at C=40, 20 requests wait for the first batch to complete).\nEstimated added wait for queued requests at C=40: ~3.9s (full C=20 batch wall time).\nRisks: head-of-line blocking, starvation under sustained load, unbounded queue growth.\nRequires: disconnect detection, cancellation, timeout, queue depth limit, per-user fairness.\nNet effect: converts fast rejection into slow queuing — user waits longer for the same outcome."
    },
    "shortestJob": {
      "description": "Priority queue: estimate execution cost, run cheapest first",
      "analysis": "All cold starts have similar cost (Docker provisioning dominates).\nCannot estimate job duration before running it.\nFor this system, all executions are roughly equivalent (print-hello).\nNo meaningful scheduling advantage over FIFO.\nAdds complexity: cost estimation, priority inversion, starvation prevention."
    },
    "boundedConcurrency": {
      "description": "Limit Docker daemon concurrency to 5 to reduce daemon lock contention",
      "analysis": "Optimal measured concurrency: C=5 (best throughput/latency ratio).\nCould reduce p95/p99 for the admitted batch by avoiding Docker daemon serialization.\nBut: current system already has maxSandboxes=20 which naturally bounds concurrency.\nAdding an inner concurrency limit below 20 would reduce effective capacity.\nThe Docker daemon is the bottleneck, not the admission logic.",
      "optimalBound": 5
    }
  },
