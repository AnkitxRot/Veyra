# CloudeeeIDE deployment environment — copy to .env and adjust. All optional
# except ADMIN_PASSWORD, which docker-compose.yml requires to be set (compose
# refuses to start without it — see ADMIN_PASSWORD below).

# Initial administrator account. Provisioned on first startup only — once the
# account exists, changing this value does NOT change its password (there is
# no rotation via env var; use the admin panel to reset a password instead).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# Host port to publish the app on.
HTTP_PORT=3000

# Host docker group gid: `getent group docker | cut -d: -f3`.
# Used so the app user can reach /var/run/docker.sock without root on a VPS.
DOCKER_GID=999

# Operational limits.
MAX_SANDBOXES=20
PROJECT_QUOTA=20
MAX_CONCURRENT_RUNS=3

# Idle sandbox timeout in milliseconds (default 30 minutes).
SANDBOX_IDLE_TIMEOUT_MS=1800000

# M81 — language-server process budget. Servers run inside the project
# sandbox; these cap how many such processes the host will keep alive.
# MAX_LSP_SERVERS=8
# MAX_LSP_SERVERS_PER_PROJECT=1
# LSP_IDLE_TIMEOUT_MS=120000
# LSP_STARTUP_TIMEOUT_MS=15000
# LSP_RESTART_WINDOW_MS=60000
# LSP_MAX_RESTARTS=3
# LSP_MESSAGE_MAX_BYTES=1048576
